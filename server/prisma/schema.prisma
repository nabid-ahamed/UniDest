// UniDest CRM — Phase 2 schema (single-tenant, SaaS-ready).
//
// Conventions applied to every model, per design spec §5.1:
//   id        BigInt   auto-increment, internal only
//   publicId  UUID     external-facing, so sequential ids never leak
//   tenantId  BigInt   always 1 in this phase; kept so the eventual SaaS
//                      switch needs no migration (spec §3)
//   createdAt / updatedAt / deletedAt   (deletedAt = soft delete)
//
// Scope note: this file covers only what Stages 2-5 need — tenancy, people,
// the status lookups, countries, and leads. Students, applications, and the
// course catalog land in their own stages rather than all at once.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of this file — it now lives in
// `prisma.config.ts` at the server root.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// One row (id = 1) in this phase. Exists so multi-tenancy is a feature flip,
/// not a data migration.
model Tenant {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  status    String    @default("active") // active | suspended | trial
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("tenants")
}

model Branch {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @db.Uuid
  tenantId  BigInt    @default(1)
  name      String
  address   String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  leads        Lead[]
  students     Student[]
  applications Application[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

/// Permissions are JSON keyed by the permission ids already used in the
/// frontend (`src/mock/roles.ts`) — e.g. ["view-leads", "lead-create-update"].
/// Reusing those exact ids means the existing Roles screen keeps working.
model Role {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @default(uuid()) @db.Uuid
  tenantId    BigInt    @default(1)
  name        String
  permissions Json      @default("[]")
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model User {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @default(uuid()) @db.Uuid
  tenantId     BigInt    @default(1)
  branchId     BigInt?
  roleId       BigInt
  name         String
  email        String
  passwordHash String
  phone        String?
  avatarUrl    String?
  status       String    @default("active") // active | invited | disabled
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branch           Branch?   @relation(fields: [branchId], references: [id])
  role             Role      @relation(fields: [roleId], references: [id])
  assignedLeads       Lead[]                     @relation("LeadAssignee")
  assignedStudents    Student[]                  @relation("StudentAssignee")
  assignedApplications Application[]             @relation("ApplicationAssignee")
  statusChanges       ApplicationStatusHistory[] @relation("StatusChangedBy")

  /// The student record this login belongs to, when the user is a student.
  studentProfile      Student?                   @relation("StudentPortalAccount")
  activityLog         ActivityLog[]              @relation("ActivityActor")

  @@unique([tenantId, email])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Configurable status lookups (spec §5.3)
//
// These are tables, not Postgres ENUMs, so a consultancy can rename or add
// pipeline stages without an ALTER TYPE migration. Reports must read the
// isWon / isLost / isTerminal FLAGS — never the labels, which tenants edit.
// ---------------------------------------------------------------------------

model LeadStatus {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @db.Uuid
  tenantId  BigInt    @default(1)
  key       String
  label     String
  color     String
  sortOrder Int       @default(0)
  isWon     Boolean   @default(false)
  isLost    Boolean   @default(false)
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  leads Lead[]

  @@unique([tenantId, key])
  @@index([tenantId, sortOrder])
  @@map("lead_statuses")
}

/// Deviation from spec §5.4, which specified `status ENUM(active|inactive)`.
/// The frontend has 8 pipeline statuses (Active, Docs Pending, Applied, Offer
/// Received, Visa Applied, Enrolled, Inactive, Withdrawn), so a binary enum
/// would break 8 UI states on day one. Mirrors LeadStatus instead.
model StudentStatus {
  id         BigInt    @id @default(autoincrement())
  publicId   String    @unique @default(uuid()) @db.Uuid
  tenantId   BigInt    @default(1)
  key        String
  label      String
  color      String
  sortOrder  Int       @default(0)
  isWon      Boolean   @default(false)
  isTerminal Boolean   @default(false)
  isSystem   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  students Student[]

  @@unique([tenantId, key])
  @@index([tenantId, sortOrder])
  @@map("student_statuses")
}

model ApplicationStatus {
  id         BigInt    @id @default(autoincrement())
  publicId   String    @unique @default(uuid()) @db.Uuid
  tenantId   BigInt    @default(1)
  key        String
  label      String
  color      String
  sortOrder  Int       @default(0)
  isWon      Boolean   @default(false)
  isTerminal Boolean   @default(false)
  isSystem   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  applications  Application[]
  historyFrom   ApplicationStatusHistory[] @relation("HistoryFrom")
  historyTo     ApplicationStatusHistory[] @relation("HistoryTo")

  @@unique([tenantId, key])
  @@index([tenantId, sortOrder])
  @@map("application_statuses")
}

// ---------------------------------------------------------------------------
// Catalog (countries only for now; universities/courses/intakes land in Stage 6)
// ---------------------------------------------------------------------------

/// tenantId is nullable here: NULL means a globally shared catalog row. Not
/// used in this phase (everything is tenant 1), but the column shape means the
/// SaaS switch can express global / per-tenant / mixed catalogs with no
/// migration (spec §3).
model Country {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @db.Uuid
  tenantId  BigInt?
  name      String    @unique
  code      String?
  flagUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  interestedLeads    Lead[]    @relation("LeadPrimaryInterest")
  residentStudents   Student[] @relation("StudentResidence")
  interestedStudents Student[] @relation("StudentInterest")
  universities       University[]

  @@index([tenantId])
  @@map("countries")
}

model University {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @db.Uuid
  tenantId  BigInt?
  countryId BigInt
  name      String
  city      String?
  website   String?
  logoUrl   String?
  /// 'Public' | 'Private'
  type        String?
  established Int?
  ranking     Int?
  showToAgent Boolean @default(true)
  /// 'Active' | 'Inactive'
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country Country  @relation(fields: [countryId], references: [id])
  courses Course[]

  @@unique([name, countryId])
  @@index([tenantId])
  @@index([countryId])
  @@map("universities")
}

/// Self-referencing two-level tree: study areas at the top (parentId NULL),
/// discipline areas beneath. Mirrors CourseCategory in src/mock/courseManagement.ts.
model CourseCategory {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @default(uuid()) @db.Uuid
  tenantId     BigInt?
  name         String
  parentId     BigInt?
  description  String?
  displayOrder Int       @default(0)
  status       String    @default("Active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  parent   CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryTree")
  courses  Course[]

  @@unique([name, parentId])
  @@index([tenantId])
  @@map("course_categories")
}

/// Money is split into amount + currency rather than the mock's single
/// "USD 100000" string, so fees can be summed, compared, and filtered.
/// Admission test minimums stay in `requirements` JSONB (spec §5.5) — they are
/// course-side thresholds, distinct from a student's own scores.
model Course {
  id           BigInt  @id @default(autoincrement())
  publicId     String  @unique @default(uuid()) @db.Uuid
  tenantId     BigInt?
  universityId BigInt
  categoryId   BigInt?

  title      String
  studyLevel String?
  /// Kept alongside durationMonths because the UI shows years.
  durationYears  Int?
  durationMonths Int?

  tuitionFee     Decimal? @db.Decimal(12, 2)
  applicationFee Decimal? @db.Decimal(12, 2)
  currency       String?  @db.VarChar(3)

  /// Fixed amount, or a formula like "10% of first year fee" — the mock mixes
  /// both, so the type is kept explicit rather than guessed at read time.
  commissionType  String?
  commissionValue String?

  /// { ielts, ieltsNoBand, toefl, pte, gre, gmat } — admission minimums.
  requirements Json @default("{}")

  description       String?
  entryRequirements String?
  websiteUrl        String?
  /// 'Enabled' | 'Disabled'
  status String @default("Enabled")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  university   University      @relation(fields: [universityId], references: [id])
  category     CourseCategory? @relation(fields: [categoryId], references: [id])
  intakes      Intake[]
  applications Application[]

  @@index([tenantId])
  @@index([universityId])
  @@index([categoryId])
  @@map("courses")
}

/// One row per intake month. `year` is nullable: the Course Finder's mock data
/// carries bare months (['Jan','Mar']) meaning "recurring every year", while
/// leads/students carry a specific "September 2026".
model Intake {
  id                  BigInt    @id @default(autoincrement())
  publicId            String    @unique @default(uuid()) @db.Uuid
  tenantId            BigInt?
  courseId            BigInt
  month               Int
  year                Int?
  applicationDeadline DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([courseId, month, year])
  @@index([tenantId])
  @@map("intakes")
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

/// Fields the API computes rather than stores (so the existing UI is unchanged):
///   status / statusColor -> joined from ApplicationStatus
///   student / studentNo  -> joined from Student
///   university / course / country -> joined through Course -> University -> Country
///   assignedTo / branch  -> joined names
model Application {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid
  tenantId BigInt @default(1)

  studentId BigInt
  courseId  BigInt?
  intakeId  BigInt?

  branchId     BigInt?
  assignedToId BigInt?
  statusId     BigInt

  /// Submission channel: DIRECT | Applyboard | Adventus | INTO Global. Kept as
  /// a plain column because it is not admin-edited in the UI.
  appliedThrough String @default("DIRECT")

  /// Free text until the agents table lands in Phase 4 (spec 5.8).
  agentName String?

  /// 'low' | 'normal' | 'high'
  priority String @default("normal")

  submittedAt DateTime?
  decisionAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student    Student           @relation(fields: [studentId], references: [id])
  course     Course?           @relation(fields: [courseId], references: [id])
  intake     Intake?           @relation(fields: [intakeId], references: [id])
  branch     Branch?           @relation(fields: [branchId], references: [id])
  assignedTo User?             @relation("ApplicationAssignee", fields: [assignedToId], references: [id])
  status     ApplicationStatus @relation(fields: [statusId], references: [id])

  statusHistory ApplicationStatusHistory[]
  documents     ApplicationDocument[]

  @@index([tenantId, statusId])
  @@index([tenantId, studentId])
  @@index([tenantId, deletedAt])
  @@map("applications")
}

/// Written on every status change, inside the same transaction as the update.
/// Gives the detail page a free timeline and an audit trail of who moved what.
model ApplicationStatusHistory {
  id            BigInt   @id @default(autoincrement())
  publicId      String   @unique @default(uuid()) @db.Uuid
  tenantId      BigInt   @default(1)
  applicationId BigInt
  fromStatusId  BigInt?
  toStatusId    BigInt
  note          String?
  changedById   BigInt?
  changedAt     DateTime @default(now())

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus  ApplicationStatus? @relation("HistoryFrom", fields: [fromStatusId], references: [id])
  toStatus    ApplicationStatus  @relation("HistoryTo", fields: [toStatusId], references: [id])
  changedBy   User?              @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([tenantId, applicationId])
  @@map("application_status_history")
}

/// Schema only in Phase 2 — fileUrl stays unpopulated until object storage
/// lands in Phase 3 (spec 8 defers the provider decision).
model ApplicationDocument {
  id            BigInt    @id @default(autoincrement())
  publicId      String    @unique @default(uuid()) @db.Uuid
  tenantId      BigInt    @default(1)
  applicationId BigInt
  name          String
  type          String
  fileUrl       String?
  fileSize      Int?
  /// 'Uploaded' | 'Pending Review' | 'Verified' | 'Rejected'
  status     String    @default("Pending Review")
  uploadedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, applicationId])
  @@map("application_documents")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

/// Fields deliberately NOT stored, because they are derived (the API computes
/// them in its response mapper so the existing UI renders unchanged):
///   leadAgeDays  -> from createdAt
///   statusColor  -> from LeadStatus.color
///   status       -> from LeadStatus.label
///   assignedTo   -> from User.name
///   branch       -> from Branch.name
model Lead {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid
  tenantId BigInt @default(1)

  name      String
  email     String?
  phone     String?
  phoneNote String?
  whatsapp  Boolean @default(false)
  gender    String?
  source    String?

  branchId                 BigInt?
  assignedToId             BigInt?
  statusId                 BigInt
  primaryInterestCountryId BigInt?

  studyLevel    String?
  qualification String?
  tags          String[] @default([])

  nextFollowUpAt DateTime?

  /// Set when this lead is converted. The lead row is NOT deleted on convert —
  /// keeping both rows preserves funnel lineage for conversion reporting.
  /// (The mock frontend deleted it; see plan decision D2.)
  convertedStudentId BigInt?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch                 Branch?    @relation(fields: [branchId], references: [id])
  assignedTo             User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  status                 LeadStatus @relation(fields: [statusId], references: [id])
  primaryInterestCountry Country?   @relation("LeadPrimaryInterest", fields: [primaryInterestCountryId], references: [id])

  /// The student this lead became. Paired with Student.lead so the funnel can
  /// be walked from either end.
  convertedStudent Student? @relation("LeadConversion", fields: [convertedStudentId], references: [id])
  /// Back-reference for Student.lead.
  studentFromLead  Student? @relation("StudentFromLead")

  @@index([tenantId, statusId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, deletedAt])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Students
// ---------------------------------------------------------------------------

/// Fields deliberately NOT stored (the API's response mapper computes them, so
/// the existing UI renders unchanged):
///   statusColor  -> from StudentStatus.color
///   status       -> from StudentStatus.label
///   assignedTo   -> from User.name
///   branch       -> from Branch.name
///   applications -> COUNT of related applications, never a stored counter
///   emailDate    -> formatted from createdAt
model Student {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid
  tenantId BigInt @default(1)

  /// Human-facing business key shown throughout the UI, e.g. "STU-2026-1902".
  /// Generated server-side as STU-{year}-{id} after insert.
  studentNo String @unique

  /// Kept as one column for Phase 2. The spec splits first/last name, but that
  /// would touch ~40 UI files for no user-visible gain, and South-Asian names
  /// split badly. Noted as a Phase 3 migration.
  name      String
  email     String?
  phone     String?
  phoneNote String?
  gender    String?
  source    String?

  branchId     BigInt?
  assignedToId BigInt?
  statusId     BigInt

  residenceCountryId BigInt?
  interestCountryId  BigInt?

  /// Free text until the catalog lands in Stage 6, then these become FKs.
  studyLevel String?
  course     String?
  intake     String?
  university String?

  avatarUrl String?

  /// The lead this student was converted from — NULL for direct sign-ups.
  leadId BigInt? @unique

  /// The login this student signs in with, NULL for students who have no portal
  /// account yet. An explicit FK rather than matching on `email`: the seeded
  /// portal login is student@gmail.com while the student record carries
  /// rohan.das@gmail.com, so an email join silently matches nothing — and a
  /// student editing their own email address would lock themselves out.
  userId BigInt? @unique

  /// Set when the student is archived. Distinct from deletedAt: archived rows
  /// are still real students the user can restore, deleted ones are in the bin.
  archivedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch           Branch?       @relation(fields: [branchId], references: [id])
  assignedTo       User?         @relation("StudentAssignee", fields: [assignedToId], references: [id])
  status           StudentStatus @relation(fields: [statusId], references: [id])
  residenceCountry Country?      @relation("StudentResidence", fields: [residenceCountryId], references: [id])
  interestCountry  Country?      @relation("StudentInterest", fields: [interestCountryId], references: [id])
  lead             Lead?         @relation("StudentFromLead", fields: [leadId], references: [id])
  user             User?         @relation("StudentPortalAccount", fields: [userId], references: [id])

  /// Back-reference for Lead.convertedStudent.
  convertedFromLeads Lead[]        @relation("LeadConversion")
  applications       Application[]

  @@index([tenantId, statusId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, deletedAt])
  @@map("students")
}

// ---------------------------------------------------------------------------
// Audit trail (spec §5.7)
// ---------------------------------------------------------------------------

/// Who changed what, and when.
///
/// Written inside the same transaction as the change it describes — the same
/// rule ApplicationStatusHistory follows. An audit row that can go missing while
/// its write succeeded is worse than none, because the log then looks complete
/// when it is not.
///
/// `entityId` is a plain BigInt rather than a foreign key on purpose: the log
/// spans leads, students, applications, staff and documents, and it must survive
/// the row it describes being deleted. That is the point of an audit trail.
model ActivityLog {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.Uuid
  tenantId BigInt @default(1)

  /// NULL for system-generated entries (seeds, migrations, scheduled jobs).
  userId BigInt?

  /// Verb, dot-namespaced: 'lead.created', 'application.status_changed'.
  action String

  /// 'lead' | 'student' | 'application' | 'staff' | 'document'
  entityType String
  entityId   BigInt

  /// Whatever the action needs to be readable later — old and new values, the
  /// status labels, a note. Shape varies by action, hence JSON.
  meta Json @default("{}")

  createdAt DateTime @default(now())

  user User? @relation("ActivityActor", fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("activity_log")
}
